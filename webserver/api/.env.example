# ---------------------------------------------------------------------------
# Application (Laravel)
# ---------------------------------------------------------------------------
APP_NAME=Vokso
APP_ENV=production
# Généré par `php artisan key:generate` (scripts/deploy.sh le fait s'il manque).
APP_KEY=
# Affichage des erreurs techniques dans les réponses HTTP : jamais en production.
APP_DEBUG=false
APP_URL=https://vokso.fr/api
PUBLIC_URL=https://vokso.fr

# Origines autorisées à appeler l'API (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Base de données (MySQL). Les anciens noms DB_NAME / DB_USER / DB_PASS sont
# aussi acceptés.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=generation_db
DB_USERNAME=
DB_PASSWORD=

# Suivi d'erreurs (Sentry) : laisser vide pour désactiver.
SENTRY_DSN_API=

# ---------------------------------------------------------------------------
# Anti-abus
# ---------------------------------------------------------------------------
# Nombre de requêtes maximum par adresse IP sur la fenêtre glissante (secondes),
# par route sensible (connexion, contact, newsletter...).
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600

# Génération gratuite et sans compte : nombre maximum de podcasts par adresse
# IP (par heure et par 24 h glissantes) et, toutes IP confondues, par 24 h
# (plafond de la facture IA). Les admins connectés ne sont pas plafonnés.
GENERATION_IP_HOURLY_LIMIT=5
GENERATION_IP_DAILY_LIMIT=10
GENERATION_GLOBAL_DAILY_LIMIT=150

# Secret de signature du jeton anti-spam invisible du formulaire de contact.
# Générer avec : openssl rand -hex 32
CAPTCHA_SECRET=

# ---------------------------------------------------------------------------
# Emails (SMTP). En local : MailHog (docker-compose), sans authentification.
# En production : SMTP_ENCRYPTION=ssl et port 465 pour un SMTP implicite TLS.
# ---------------------------------------------------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_ENCRYPTION=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=contact@vokso.fr
MAIL_FROM_NAME=Vokso
CONTACT_TO=contact@vokso.fr

# ---------------------------------------------------------------------------
# IA : Mistral pour le texte, l'image, la voix et la transcription.
# AI_TEXT_PROVIDER=ollama permet de passer le texte par Ollama Cloud.
# ---------------------------------------------------------------------------
AI_TEXT_PROVIDER=mistral

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TEXT_MODEL=mistral-small-latest
# Laisser vide : un agent "web_search" (narration) et un agent
# "image_generation" sont créés au premier appel. Renseigner leurs ids une
# fois connus (logs) évite de les recréer à chaque génération.
MISTRAL_TEXT_AGENT_ID=
MISTRAL_IMAGE_MODEL=mistral-medium-latest
MISTRAL_IMAGE_AGENT_ID=
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
MISTRAL_SPEECH_MODEL=voxtral-mini-tts-latest
# Voix française "Marie", ton neutre (liste : GET https://api.mistral.ai/v1/audio/voices).
MISTRAL_SPEECH_VOICE=fr_marie_neutral

OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_TEXT_MODEL=
