# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
DB_HOST=db
DB_NAME=generation_db
DB_USER=
DB_PASS=

# Origines autorisées à appeler l'API (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000

# Affichage des erreurs techniques dans les réponses HTTP : jamais en production
APP_DEBUG=false

# Suivi d'erreurs (Sentry) : DSN du projet API sur sentry.io. Laisser vide pour
# désactiver (le SDK devient alors un no-op, aucune configuration requise en
# local). https://docs.sentry.io/platforms/php/
SENTRY_DSN_API=

# Quota anti-abus sur /generation (appels IA payants) : nombre de requêtes
# maximum par adresse IP sur la fenêtre glissante (en secondes)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600

# Base URL du front (React), utilisée pour construire les URLs de retour de
# Stripe Checkout / Billing Portal. Pas de slash final.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Paiement (Stripe) — formules Créateur et Studio de /tarifs. Découverte est
# gratuite et ne passe jamais par Stripe (voir SQL/20260922020000.sql).
# Clés à récupérer sur https://dashboard.stripe.com/apikeys (clé secrète) et
# https://dashboard.stripe.com/webhooks (secret de signature, après avoir créé
# l'endpoint /billing-webhook). STRIPE_PRICE_* sont les ids "price_..." des
# deux abonnements mensuels créés dans le Dashboard Stripe > Produits.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATEUR=
STRIPE_PRICE_STUDIO=

# ---------------------------------------------------------------------------
# Mails de service (inscription à la newsletter, etc.)
# En local, tout part vers MailHog (voir docker-compose.yml, port 1025) et se
# consulte sur http://localhost:8026. À remplacer par un vrai fournisseur SMTP
# une fois vokso.fr en production.
# ---------------------------------------------------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
MAIL_FROM=contact@vokso.fr

# ---------------------------------------------------------------------------
# Choix des moteurs d'IA, capacité par capacité
# Texte, image, transcription et voix passent tous par Mistral. L'image
# passe par un agent doté de l'outil "image_generation" + l'API Conversations
# (API bêta) : pas de route REST unique comme /v1/images/generations chez
# OpenAI, voir MistralImageProvider. OpenAI n'est plus utilisé (décision
# produit) : "openai" n'est plus une valeur valide pour ces réglages.
#   AI_TEXT_PROVIDER ............ mistral | ollama
#   AI_IMAGE_PROVIDER ........... mistral
#   AI_SPEECH_PROVIDER .......... mistral | local
#   AI_TRANSCRIPTION_PROVIDER ... mistral | whisper
# ---------------------------------------------------------------------------
AI_TEXT_PROVIDER=mistral
AI_IMAGE_PROVIDER=mistral
AI_SPEECH_PROVIDER=mistral
AI_TRANSCRIPTION_PROVIDER=mistral

# --- Mistral (texte, image, transcription Voxtral et voix Voxtral TTS, API compatible OpenAI) ---
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TEXT_MODEL=mistral-small-latest
MISTRAL_IMAGE_MODEL=mistral-medium-latest
# Laisser vide : un agent "image_generation" est créé au premier appel. Une
# fois son id connu (logs), le renseigner ici évite de recréer un agent à
# chaque génération de podcast.
MISTRAL_IMAGE_AGENT_ID=
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
MISTRAL_SPEECH_MODEL=voxtral-mini-tts-latest
# Voix française "Marie", ton neutre — identifiant confirmé via GET
# https://api.mistral.ai/v1/audio/voices (liste des ~30 voix disponibles).
MISTRAL_SPEECH_VOICE=fr_marie_neutral

# --- Serveur TTS compatible OpenAI : Kokoro-FastAPI, openedai-speech… (audio) ---
TTS_BASE_URL=http://tts:8880/v1
TTS_MODEL=tts-1
TTS_VOICE=ff_siwis
TTS_FORMAT=mp3

# --- Serveur Whisper compatible OpenAI (transcription) ---
WHISPER_BASE_URL=http://whisper:8000/v1
WHISPER_MODEL=Systran/faster-whisper-medium
WHISPER_LANGUAGE=fr
