# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
DB_HOST=db
DB_NAME=generation_db
DB_USER=
DB_PASS=

# Origines autorisées à appeler l'API (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000

# Affichage des erreurs techniques dans les réponses HTTP : jamais en production
APP_DEBUG=false

# Suivi d'erreurs (Sentry) : DSN du projet API sur sentry.io. Laisser vide pour
# désactiver (le SDK devient alors un no-op, aucune configuration requise en
# local). https://docs.sentry.io/platforms/php/
SENTRY_DSN_API=

# Quota anti-abus sur /generation (appels IA payants) : nombre de requêtes
# maximum par adresse IP sur la fenêtre glissante (en secondes)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600

# ---------------------------------------------------------------------------
# Mails de service (inscription à la newsletter, etc.)
# En local, tout part vers MailHog (voir docker-compose.yml, port 1025) et se
# consulte sur http://localhost:8026. À remplacer par un vrai fournisseur SMTP
# une fois vokso.fr en production.
# ---------------------------------------------------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
MAIL_FROM=contact@vokso.fr

# ---------------------------------------------------------------------------
# Choix des moteurs d'IA, capacité par capacité
# Texte, transcription et voix passent par Mistral. L'image reste sur OpenAI :
# ni Ollama Cloud ni l'API REST de Mistral n'exposent de génération d'image
# simple (Mistral ne l'expose que via un outil agentique, pas encore câblé
# ici) — OPENAI_API_KEY reste donc obligatoire pour la vignette.
#   AI_TEXT_PROVIDER ............ mistral | openai | ollama
#   AI_SPEECH_PROVIDER .......... mistral | openai | local
#   AI_TRANSCRIPTION_PROVIDER ... mistral | openai | whisper
# ---------------------------------------------------------------------------
AI_TEXT_PROVIDER=mistral
AI_SPEECH_PROVIDER=mistral
AI_TRANSCRIPTION_PROVIDER=mistral

# --- Mistral (texte, transcription Voxtral et voix Voxtral TTS, API compatible OpenAI) ---
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TEXT_MODEL=mistral-small-latest
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
MISTRAL_SPEECH_MODEL=voxtral-mini-tts-latest
# Voix française "Marie", ton neutre — identifiant confirmé via GET
# https://api.mistral.ai/v1/audio/voices (liste des ~30 voix disponibles).
MISTRAL_SPEECH_VOICE=fr_marie_neutral

# --- OpenAI (encore utilisé pour l'image : pas d'équivalent Mistral câblé) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_SPEECH_MODEL=tts-1-hd
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- Serveur TTS compatible OpenAI : Kokoro-FastAPI, openedai-speech… (audio) ---
TTS_BASE_URL=http://tts:8880/v1
TTS_MODEL=tts-1
TTS_VOICE=ff_siwis
TTS_FORMAT=mp3

# --- Serveur Whisper compatible OpenAI (transcription) ---
WHISPER_BASE_URL=http://whisper:8000/v1
WHISPER_MODEL=Systran/faster-whisper-medium
WHISPER_LANGUAGE=fr
