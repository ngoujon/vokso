# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
DB_HOST=db
DB_NAME=generation_db
DB_USER=
DB_PASS=

# Origines autorisées à appeler l'API (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000

# Affichage des erreurs techniques dans les réponses HTTP : jamais en production
APP_DEBUG=false

# Quota anti-abus sur /generation (appels IA payants) : nombre de requêtes
# maximum par adresse IP sur la fenêtre glissante (en secondes)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600

# ---------------------------------------------------------------------------
# Choix des moteurs d'IA, capacité par capacité
#   AI_TEXT_PROVIDER ............ openai | ollama | ollamacloud
#   AI_IMAGE_PROVIDER ........... openai | stablediffusion
#   AI_SPEECH_PROVIDER .......... openai | local
#   AI_TRANSCRIPTION_PROVIDER ... openai | whisper
# Ollama ne sait produire que du texte : une installation 100 % locale combine
# Ollama + Stable Diffusion + un serveur TTS + un serveur Whisper.
# ---------------------------------------------------------------------------
AI_TEXT_PROVIDER=openai
AI_IMAGE_PROVIDER=openai
AI_SPEECH_PROVIDER=openai
AI_TRANSCRIPTION_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_SPEECH_MODEL=tts-1-hd
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# --- Ollama (texte) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TEXT_MODEL=llama3.1:8b

# --- Ollama Cloud (texte, nécessite une clé API sur ollama.com) ---
OLLAMACLOUD_BASE_URL=https://ollama.com
OLLAMACLOUD_API_KEY=
OLLAMACLOUD_TEXT_MODEL=gpt-oss:120b

# --- Stable Diffusion / AUTOMATIC1111 (image) ---
SD_BASE_URL=http://stable-diffusion:7860
SD_WIDTH=1024
SD_HEIGHT=1024
SD_STEPS=30

# --- Serveur TTS compatible OpenAI : Kokoro-FastAPI, openedai-speech… (audio) ---
TTS_BASE_URL=http://tts:8880/v1
TTS_MODEL=tts-1
TTS_VOICE=ff_siwis
TTS_FORMAT=mp3

# --- Serveur Whisper compatible OpenAI (transcription) ---
WHISPER_BASE_URL=http://whisper:8000/v1
WHISPER_MODEL=Systran/faster-whisper-medium
WHISPER_LANGUAGE=fr
