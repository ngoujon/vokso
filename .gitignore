# Secrets et configuration locale (seuls les modèles .env.example sont versionnés)
.env*
*.env
!.env.example
!webserver/api/.env.example
docker-compose.override.yml

# Dépendances et builds
webserver/node_modules/
webserver/build/
webserver/api/vendor/
*.tsbuildinfo

# Données générées à l'exécution
/logs/*
webserver/logs/
webserver/public/output/
webserver/api/storage/
/backups/

# .htaccess : seuls ceux du dépôt sont versionnés
*.htaccess
!site/.htaccess
!webserver/api/.htaccess
!webserver/api/public/.htaccess

# Tests et outils
webserver/api/.phpunit.result.cache
webserver/api/.phpunit.cache/
/coverage
.playwright-mcp/
npm-debug.log*

# Divers
.DS_Store
*.pem
desktop.png
test_audio.m4a
