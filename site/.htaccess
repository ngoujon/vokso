# Ces règles vivent ici plutôt qu'uniquement dans apache-config/vokso.conf
# parce que le vhost HTTPS réellement servi en production est un fichier
# généré par certbot (typiquement vokso-le-ssl.conf, voir
# scripts/setup-server.sh) : un clone figé du vhost pris au moment de son
# exécution, hors du dépôt, jamais resynchronisé par scripts/deploy.sh. Un
# .htaccess est en revanche relu à chaque requête directement depuis site/
# (AllowOverride All), donc actif aussi bien en HTTP qu'en HTTPS sans dépendre
# de quel vhost sert réellement le trafic.
RewriteEngine On

# Domaine canonique fixe (vokso.fr, jamais www.vokso.fr) : les deux servaient
# jusqu'ici le même contenu sans redirection (signal SEO dilué). Voir aussi
# webserver/src/lib/usePageMeta.ts (filet de sécurité côté JS, insuffisant seul pour un
# crawler qui n'exécute pas le JS).
RewriteCond %{HTTP_HOST} ^www\.vokso\.fr$ [NC]
RewriteRule ^ https://vokso.fr%{REQUEST_URI} [L,R=301]

# Anciennes URL d'épisode relevées en 404 dans Google Search Console
# (docs/audits/vokso-gsc-urls.md) : épisodes supprimés puis recréés sous un
# autre identifiant, ou slug tronqué. Redirection vers l'épisode actuel.
RewriteRule ^podcast/gen_6ab2918d862ad-jupiter-la-geante-mysterieuse/?$ https://vokso.fr/podcast/jupiter-la-geante-qui-fascine-le-systeme-solaire [R=301,L]
RewriteRule ^podcast/gen_6ab2931c9df2c-decouvrez-les-secrets-de-saturne/?$ https://vokso.fr/podcast/saturne-et-ses-anneaux-un-mystere-celeste [R=301,L]
RewriteRule ^podcast/independance-de-l-ouganda-le-9-octobre-1962-et-la-construction-d-une-/?$ https://vokso.fr/podcast/independance-de-l-ouganda-le-9-octobre-1962-et-la-construction-d-une-nation [R=301,L]

# /podcast seul n'a jamais été une page : le catalogue des épisodes est la
# discothèque.
RewriteRule ^podcast/?$ https://vokso.fr/discotheque [R=301,L]

# Épisode public rendu côté serveur (voir PodcastPageController) :
# /podcast/{slug} -> /api/podcast/{slug}. Les anciennes URL
# /podcast/{generation_id}-{titre} (ex. "gen_6ab267b302f6d-jupiter") passent
# par la même règle et sont redirigées en 301 par le contrôleur.
RewriteRule ^podcast/([A-Za-z0-9_-]+)/?$ /api/podcast/$1 [PT,L]

# Page d'une catégorie rendue côté serveur (voir CategoryPageController).
RewriteRule ^discotheque/([a-z0-9-]+)/?$ /api/discotheque/$1 [PT,L]

# Index complet des épisodes pour les assistants IA (voir LlmsController).
RewriteRule ^llms-full\.txt$ /api/llms-full [PT,L]

# Administration à l'adresse /admin : sert l'application React (build sous
# /app), qui détecte ce chemin et y affiche connexion puis tableau de bord.
RewriteRule ^admin/?$ /app/index.html [PT,L]

# Pages de la vitrine servies sans extension (fichiers .html de site/).
RewriteRule ^discotheque/?$ /discotheque.html [L]
RewriteRule ^comment-ca-marche/?$ /comment-ca-marche.html [L]

# Sitemap généré dynamiquement à partir des épisodes publiés (voir
# SitemapController), au lieu d'un fichier statique figé sur la page d'accueil.
RewriteRule ^sitemap\.xml$ /api/sitemap [PT,L]

# Sonde de supervision publique (voir HealthController) : chemin exact
# uniquement, GET/HEAD, réponse {"status":"ok"} sans aucun détail.
RewriteRule ^health$ /api/health [PT,L]
